@model TechTools.WebShop.Models.CPUDetailsViewModel 

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div>
    <h4>GPU</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPU.Brand)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CPU.Brand)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPU.Model)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CPU.Model)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPU.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CPU.Price)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPU.Picture)
        </dt>
        <dd class="col-sm-10">
            <img src="~/images/cpus/@(string.IsNullOrEmpty(Model.CPU.Picture) ? "default.png" : Model.CPU.Picture)"
                 alt="CPU Picture" width="150" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPU.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CPU.Description)
        </dd>
    </dl>
</div>

<section class="mt-4">
    <h4>Reviews</h4>

    @if (!Model.Reviews.Any())
    {
        <p>Er zijn nog geen reviews voor dit product.</p>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var review in Model.Reviews)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <strong>@review.PersonName</strong>
                        <span>Score: @review.Score / 5</span>
                    </div>
                    <p class="mb-0">@review.Comment</p>
                </div>
            }
        </div>
    }

    @if (User.IsInRole("Klant"))
    {
        <h5>Review toevoegen</h5>
        <form asp-action="AddReview" method="post" class="mb-4">
            <input type="hidden" name="CPUId" value="@Model.CPU.Id" />

            <div class="mb-3">
                <label class="form-label">Naam</label>
                <input name="PersonName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Opmerking</label>
                <textarea name="Comment" class="form-control" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Score (0-5)</label>
                <input name="Score" type="number" min="0" max="5" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary">Review opslaan</button>
        </form>
    }
</section>

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Shopmanager"))
    {
        <a asp-action="Edit" asp-route-id="@Model.CPU.Id">Edit</a> <span>|</span>
    }

    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
