@using TechTools.Models
@model UserRolesVM

<h2>Rollen beheren voor @Model.Email</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="UserId" />

    @for (int i = 0; i < Model.Roles.Count; i++)
    {
        <div class="form-check">
            <input type="hidden" asp-for="Roles[i].RoleName" />

            <input type="checkbox"
                   asp-for="Roles[i].IsSelected"
                   class="form-check-input" />

            <label class="form-check-label">
                @Model.Roles[i].RoleName
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Bewaren</button>
</form>