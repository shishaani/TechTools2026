@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>
 
<h2>Gebruikers</h2>
 
<table class="table table-striped">
    <thead>
        <tr>
            <th>E-mail</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <a asp-action="Edit"
                           asp-route-userId="@user.Id"
                           class="btn btn-sm btn-primary">
                        Rollen beheren
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table